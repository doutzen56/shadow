{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simpx/contracts/task-contract/v1",
  "title": "SimpX 任务契约",
  "description": "一个任务的目标、owner、依赖、允许修改路径、验收条件和状态。只用 orchestration/tools/schema_check.py 支持的关键字。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_type", "task_id", "title", "status", "state", "task_type",
    "owner_role", "goal", "depends_on", "contract_refs", "parallel", "workspace", "acceptance",
    "verification", "created_by", "approved_by"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "v1"},
    "contract_type": {"type": "string", "const": "task"},
    "task_id": {"type": "string", "pattern": "^TASK-[A-Za-z0-9][A-Za-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "status": {
      "description": "任务契约本身的审批状态",
      "type": "string",
      "enum": ["draft", "review", "approved", "superseded", "rejected"]
    },
    "state": {
      "description": "任务执行状态；合法跳转见 orchestration/policies/task-states.yaml",
      "type": "string",
      "enum": ["Draft", "Planned", "ContractReady", "Ready", "Running", "Implemented", "Integrated", "Verified", "Accepted", "Blocked", "Failed", "Cancelled"]
    },
    "task_type": {
      "type": "string",
      "enum": ["implementation", "design", "verification", "environment", "review", "research", "documentation"]
    },
    "owner_role": {"type": "string", "pattern": "^(@@[A-Z]+|reviewer|researcher)$"},
    "project_id": {"type": ["string", "null"]},
    "goal": {"type": "string", "minLength": 1},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^TASK-[A-Za-z0-9][A-Za-z0-9-]*$"}
    },
    "contract_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "path"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "path": {"description": "相对本任务文件所在目录的路径", "type": "string", "minLength": 1}
        }
      }
    },
    "risk_tags": {"type": "array", "items": {"type": "string"}},
    "parallel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "rationale"],
      "properties": {
        "class": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
        "rationale": {"type": "string", "minLength": 1},
        "group_id": {"type": ["string", "null"]}
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allowed_paths"],
      "properties": {
        "mode": {"description": "session：会话内按顺序执行；isolated：有独立工作区；shared：和其他任务共用工作区", "type": "string", "enum": ["session", "isolated", "shared"]},
        "workspace_ref": {"type": ["string", "null"]},
        "allowed_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "forbidden_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "shared_resources": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "verification_method", "evidence_required"],
        "properties": {
          "id": {"type": "string", "pattern": "^AC-[A-Za-z0-9-]+$"},
          "description": {"type": "string", "minLength": 1},
          "verification_method": {"type": "string", "minLength": 1},
          "evidence_required": {"type": "boolean"}
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_checks", "commands", "not_run_reason"],
      "properties": {
        "required_checks": {"type": "array", "items": {"type": "string"}},
        "commands": {"type": "array", "items": {"type": "string"}},
        "not_run_reason": {"type": ["string", "null"]}
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "next_role": {"type": ["string", "null"]},
        "required_evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "state_history": {
      "description": "状态变化记录，按时间顺序；最后一条的 to 要等于当前 state",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "actor", "from", "to", "reason"],
        "properties": {
          "at": {"type": "string", "minLength": 1},
          "actor": {"type": "string", "minLength": 1},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "reason": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "created_by": {"type": "string", "minLength": 1},
    "approved_by": {"type": ["string", "null"]}
  }
}
