{
  // 复制成同目录下的 Secrets.json 再填，Secrets.json 不进 git。四个宿主共用这一份，各宿主的密钥自然一致。
  // 生产环境还在用仓库里的默认 JWT、国密、内部调用、看板密钥时，宿主会直接启动失败。
  "JWTSettings": {
    "IssuerSigningKey": "" // JWT 签名密钥，至少 32 位随机字符
  },
  "Cryptogram": {
    // 国密 SM2 的一对密钥：本地启动 Admin 登录后调 /api/system/common/smKeyPair 生成。
    // 公钥要同步改到 Web/.env 的 VITE_SM_PUBLIC_KEY，再重新编译前端
    "PublicKey": "",
    "PrivateKey": ""
  },
  "InternalCall": {
    "AccessSecret": "" // 宿主之间内部调用的签名密钥，至少 32 位随机字符
  },
  "ScheduleHost": {
    "DashboardAppSecret": "", // 调度看板登录凭据的签名密钥，至少 16 位
    "DashboardUsername": "", // 调度看板账号，留空就不允许登录看板
    "DashboardPassword": ""
  },
  "DbConnection": {
    "ConnectionConfigs": [
      // 中心库：密码和 docker/.env 的 MSSQL_SA_PASSWORD 一致；库不存在时 Admin 启动会自动建。
      // 租户独立库不要写在这里，在总后台「租户」里维护连接串（可仍指向本 SQL Server 的其他 Database）。
      { "ConnectionString": "Server=sqlserver,1433;Database=SimpX;User Id=sa;Password=这里填密码;Encrypt=True;TrustServerCertificate=True;" }
    ]
  },
  "Cache": {
    "Redis": {
      "Configuration": "server=redis:6379;password=这里填密码;db=5;" // 密码和 docker/.env 里的 REDIS_PASSWORD 一样
    }
  }
}
