<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>1701;1702;1591;8632</NoWarn>
    <DocumentationFile></DocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <PreserveCompilationContext>true</PreserveCompilationContext>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Copyright>SimpX.Net</Copyright>
    <Description>SimpX.Net 内核：通用工具、常量、校验特性等（不含 SqlSugar / 鉴权实现 / 邮件短信等可选能力）</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Furion" Version="4.9.9.92" />
    <PackageReference Include="Furion.Extras.ObjectMapper.Mapster" Version="4.9.9.92" />
    <PackageReference Include="Yitter.IdGenerator" Version="1.0.14" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.4" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="IPTools.China" Version="1.6.0" />
    <PackageReference Include="IPTools.International" Version="1.6.0" />
    <PackageReference Include="UAParser" Version="3.1.47" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimpX.Net.Caching\SimpX.Net.Caching.csproj" />
  </ItemGroup>

</Project>
