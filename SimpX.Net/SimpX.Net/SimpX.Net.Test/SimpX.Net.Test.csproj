<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>1701;1702;1591;8632</NoWarn>
    <DocumentationFile></DocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <PreserveCompilationContext>true</PreserveCompilationContext>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <UseAppHost>true</UseAppHost>
	<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
	<Copyright>SimpX.Net</Copyright>
    <Description>SimpX.Net 通用权限开发平台</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Furion.Xunit" Version="4.9.9.92" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="Selenium.Support" Version="4.49.0" />
    <PackageReference Include="Selenium.WebDriver" Version="4.49.0" />
    <PackageReference Include="Selenium.WebDriver.MSEdgeDriver" Version="151.0.4129.59" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <!-- 引用矩阵见 README.md：Utils 单测只引 Core；UI 不引业务项目；Data/Feature/Application 按目录再加 -->
  <ItemGroup>
    <ProjectReference Include="..\SimpX.Net.Core\SimpX.Net.Core.csproj" />
    <ProjectReference Include="..\SimpX.Net.Data\SimpX.Net.Data.csproj" />
    <ProjectReference Include="..\SimpX.Net.Hosting\SimpX.Net.Hosting.csproj" />
    <ProjectReference Include="..\SimpX.Net.Application.Shared\SimpX.Net.Application.Shared.csproj" />
  </ItemGroup>
</Project>
