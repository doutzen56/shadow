{
  "$schema": "https://gitee.com/dotnetchina/Furion/raw/v4/schemas/v4/furion-schema.json",

  // 按顺序扫描这些目录（相对程序所在目录）里的 json 并合并，后扫到的同名配置盖掉前面的，同名文件也会盖。
  // Deploy/Shared 放各宿主共用的部署配置（数据库、Redis、密钥），Deploy/Host 放本宿主自己的部署配置；开发环境没有这两个目录，直接跳过
  "ConfigurationScanDirectories": [ "Configuration", "", "Deploy/Shared", "Deploy/Host" ]
}
