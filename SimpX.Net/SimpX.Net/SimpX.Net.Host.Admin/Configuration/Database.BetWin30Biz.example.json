{
  "$schema": "https://gitee.com/dotnetchina/Furion/raw/v4/schemas/v4/furion-schema.json",
  "_comment": "示例：在 Database.json 的 ConnectionConfigs 数组末尾追加一段，ConfigId 必须是 BetWin30Biz。主库仍用 Sqlite 管 Sys*。业务段 EnableInit* 全 false，禁止 CodeFirst。连接串自备勿提交。",
  "append_connection": {
    "ConfigId": "BetWin30Biz",
    "DbType": "SqlServer",
    "DbNickName": "BetWin30业务库",
    "ConnectionString": "Server=YOUR_SERVER;Database=BetWin30;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;",
    "DbSettings": {
      "EnableInitDb": false,
      "EnableInitView": false,
      "EnableDiffLog": false,
      "EnableUnderLine": false,
      "EnableConnEncrypt": false
    },
    "TableSettings": {
      "EnableInitTable": false,
      "EnableIncreTable": false
    },
    "SeedSettings": {
      "EnableInitSeed": false,
      "EnableIncreSeed": false
    }
  }
}
