<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>1701;1702;1591;8632</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Copyright>SimpX.Net</Copyright>
    <Description>SimpX.Net 事件总线 RabbitMQ 实现。默认事件源走内存或 Redis；要用 RabbitMQ 时再引用本包并替换存储器。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimpX.Net.Core\SimpX.Net.Core.csproj" />
    <ProjectReference Include="..\SimpX.Net.Feature.EventBus\SimpX.Net.Feature.EventBus.csproj" />
  </ItemGroup>

</Project>